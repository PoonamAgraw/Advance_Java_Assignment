<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">
  <display-name>ProductCrudDemo</display-name>
  <welcome-file-list>
    <welcome-file>Login.html</welcome-file>
    
  </welcome-file-list>
  
  <servlet>
     <servlet-name>login</servlet-name>
     <servlet-class>com.demo.servlets.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
   <servlet-name>login</servlet-name>
   <url-pattern>/validateUSer</url-pattern>
  </servlet-mapping>
  
  <servlet>
     <servlet-name>show</servlet-name>
     <servlet-class>com.demo.servlets.ShowProduct</servlet-class>
  </servlet>
  <servlet-mapping>
   <servlet-name>show</servlet-name>
   <url-pattern>/ShowProduct</url-pattern>
  </servlet-mapping>
  
  <servlet>
     <servlet-name>add</servlet-name>
     <servlet-class>com.demo.servlets.AddProduct</servlet-class>
  </servlet>
  <servlet-mapping>
   <servlet-name>add</servlet-name>
   <url-pattern>/AddProduct</url-pattern>
  </servlet-mapping>
  
  <servlet>
     <servlet-name>edit</servlet-name>
     <servlet-class>com.demo.servlets.EditProduct</servlet-class>
  </servlet>
  <servlet-mapping>
   <servlet-name>edit</servlet-name>
   <url-pattern>/EditProduct</url-pattern>
  </servlet-mapping>
  
  <servlet>
     <servlet-name>update</servlet-name>
     <servlet-class>com.demo.servlets.UpdateProduct</servlet-class>
  </servlet>
  <servlet-mapping>
   <servlet-name>update</servlet-name>
   <url-pattern>/UpdateProduct</url-pattern>
  </servlet-mapping>
  
  <servlet>
     <servlet-name>delete</servlet-name>
     <servlet-class>com.demo.servlets.DeleteProduct</servlet-class>
  </servlet>
  <servlet-mapping>
   <servlet-name>delete</servlet-name>
   <url-pattern>/DeleteProduct</url-pattern>
  </servlet-mapping>
  
  
</web-app>